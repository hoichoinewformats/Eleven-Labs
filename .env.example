# 3 required vars - everything else has sane defaults baked in.

# Postgres connection. Recommended: a free Neon project.
# https://console.neon.tech -> create project -> copy "Pooled connection" URL.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require

# OpenRouter routes one API to many models (Claude, GPT, Llama, Nemotron…).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ElevenLabs Shared Voice Library access.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Optional overrides (defaults are fine for most cases) ---
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# PORT=4000
# HOST=0.0.0.0
# CORS_ORIGIN=*           # comma-separated list, or * to allow any origin
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=25
