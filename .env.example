# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
# Example: postgresql://user:pass@localhost:5432/logline_ai?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logline_ai?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Default analyzer model. Sonnet 4.6 is a good speed/quality balance.
# Use claude-opus-4-7 for best quality on long/complex scripts.
CLAUDE_MODEL=claude-sonnet-4-6

# --- ElevenLabs ---
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
